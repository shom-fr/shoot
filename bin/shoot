#!/usr/bin/env python3
"""
shoot commandline interface
"""

import pathlib
import sys

this_file = pathlib.Path(__file__)
if (this_file.parent.parent / "shoot" / "__init__.py").exists():
    sys.path.insert(0, str(this_file.parent.parent))


from shoot.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
